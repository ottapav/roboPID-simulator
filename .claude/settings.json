{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "defaultMode": "acceptEdits",

  "permissions": {
    "allow": [
      "Read(*)",
      "Edit(*)",

      "Bash(py *)",
      "Bash(python *)",
      "Bash(python3 *)",

      "Bash(pip *)",
      "Bash(pytest *)",

      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(cd *)",
      "Bash(pwd)",

      "Bash(cat *)",
      "Bash(type *)",

      "Bash(find *)",
      "Bash(fd *)",
      "Bash(rg *)",
      "Bash(grep *)",

      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",

      "Bash(curl http://localhost:*)",
      "Bash(curl http://127.0.0.1:*)",

      "Bash(docker ps)",
      "Bash(docker images)",
      "Bash(docker compose ps)"
    ],

    "ask": [
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",

      "Bash(docker compose up *)",
      "Bash(docker build *)",
      "Bash(docker run *)",

      "Bash(curl https://*)",
      "Bash(curl http://*)"
    ],

    "deny": [
      "Bash(rm *)",
      "Bash(del *)",
      "Bash(rmdir *)",

      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",

      "Bash(sudo *)",
      "Bash(chmod *)",
      "Bash(chown *)",

      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.ssh/**)"
    ]
  }
}