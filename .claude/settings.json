{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "defaultMode": "acceptEdits",
  "disableBypassPermissionsMode": "disable",

  "permissions": {
    "allow": [
      "Read(*)",
      "Edit(*)",

      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(pwd)",
      "Bash(cd *)",

      "Bash(find *)",
      "Bash(fd *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed *)",
      "Bash(awk *)",

      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git fetch)",

      "Bash(python *)",
      "Bash(py *)",
      "Bash(python3 *)",

      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npm test *)",

      "Bash(cmake *)",
      "Bash(make *)",
      "Bash(ctest *)",

      "Bash(docker ps)",
      "Bash(docker images)",
      "Bash(docker compose ps)"
    ],

    "ask": [
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git checkout *)",

      "Bash(docker build *)",
      "Bash(docker compose up *)",
      "Bash(docker run *)",

      "Bash(cargo publish *)",
      "Bash(npm publish *)",

      "Bash(curl *)",
      "Bash(wget *)"
    ],

    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(./**/.ssh/**)",

      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(del *)",
      "Bash(format *)",
      "Bash(mkfs *)",

      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",

      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(chown *)",

      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(poweroff *)"
    ]
  }
}